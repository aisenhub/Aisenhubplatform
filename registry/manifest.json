{
  "schema_version": "3.0.0",
  "status": "local-only",
  "registry_name": "aisenhub-local-registry",
  "build": {
    "node": "24.19.0",
    "pnpm": "11.18.0",
    "next": "16.3.8",
    "admin_consumer_lab": "apps/admin",
    "consumer_harness": "tests/consumer-harness"
  },
  "contract_compatibility": {
    "account": {
      "major": "v1",
      "contract": "contracts/account/v1/openapi.json"
    },
    "admin": {
      "major": "v1",
      "contract": "contracts/admin/v1/openapi.json"
    },
    "consumer_harness": "tests/consumer-harness",
    "consumer_lab": "apps/admin/app/admin/consumer-lab/page.tsx"
  },
  "verification": {
    "static": "pnpm test:consumer-harness",
    "local_e2e": "pnpm test:e2e:consumer-harness"
  },
  "install": {
    "command": "pnpm install --frozen-lockfile",
    "note": "This manifest records local contract/conformance surfaces; it is not a published npm, template distribution, or production Registry entry."
  }
}
