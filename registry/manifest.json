{
  "schema_version": "2.0.0",
  "status": "local-only",
  "registry_name": "aisenhub-local-registry",
  "build": {
    "node": "24.19.0",
    "pnpm": "11.18.0",
    "next": "16.3.8",
    "source_package": "apps/template-preview"
  },
  "contract_compatibility": {
    "account": {
      "major": "v1",
      "contract": "contracts/account/v1/openapi.json"
    },
    "admin": {
      "major": "v1",
      "contract": "contracts/admin/v1/openapi.json"
    },
    "reference_consumer": "apps/template-preview"
  },
  "templates": "registry/templates.json",
  "install": {
    "command": "pnpm install --frozen-lockfile",
    "note": "This manifest describes a local preview; it is not a published npm or production Registry entry."
  }
}
