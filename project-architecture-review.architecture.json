  "cards": [
    {
      "dot": "cyan",
      "title": "当前边界",
      "items": [
        "身份全局共享，业务账户按 platform_id 隔离",
        "浏览器通过同源 BFF 访问中央 API，不直连 SQL 或私有 Storage",
        "Platform Key 证明平台调用方，不是跨平台用户令牌"
      ]
    },
    {
      "dot": "emerald",
      "title": "领域一致性",
      "items": [
        "权益、配额、兑换与文件状态由 PostgreSQL private 函数统一写入",
        "Account、Admin、Maintenance 使用分离 executor 与短事务",
        "文件写入把数据库状态与 Storage 事实拆成可恢复状态机"
      ]
    },
    {
      "dot": "violet",
      "title": "计费事实链",
      "items": [
        "Checkout snapshot、Provider Order/Settlement 与 hash-only Inbox 保留事实边界",
        "Provider webhook 进入可接管 processing job，再由领域入口落权益",
        "没有 verified Provider mapping 时购买保持关闭"
      ]
    },
    {
      "dot": "amber",
      "title": "审查关注",
      "items": [
        "schedule.json 只是任务元数据，不证明生产调度器已运行",
        "仓库 CI 没有生产部署步骤，备份/恢复自动化存在明确门槛",
        "Supabase Secret Key 仍是高影响运行时凭据，需要独立环境与日志脱敏"
      ]
    }
  ]
}
