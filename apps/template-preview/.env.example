NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 兼容旧项目，也可以使用 anon key；不要在浏览器环境配置 service_role key。
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The server-only BFF uses the Platform Key to select model.aisenhub.
# Local default:
ACCOUNT_API_URL=http://127.0.0.1:8787
# Staging example (fill the key from the Admin Platform Key flow; never expose it
# with NEXT_PUBLIC_ and never commit the real value):
# ACCOUNT_API_URL=https://egsokuicabbxspkdccqe.supabase.co/functions/v1/account-api
# ACCOUNT_PLATFORM_KEY=<server-only-model-aisenhub-platform-key>
ACCOUNT_PLATFORM_KEY=
TEMPLATE_ORIGIN=http://localhost:3000
