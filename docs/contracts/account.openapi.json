        "operationId": "issueRecentAuthProof",
        "tags": ["account"],
        "x-module": "M2",
        "x-implementation-status": "local-only",
        "x-reauthentication-event": "supabase-auth-email-otp-session",
        "x-proof-binding": "original-user-session",
        "security": [{ "platformKey": [], "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/PlatformKey" },
          { "$ref": "#/components/parameters/ReauthAccessToken" }
        ],
        "responses": {
          "201": { "$ref": "#/components/responses/RecentAuthProof" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/account/activate": {
      "post": {
        "operationId": "activateAccount",
        "tags": ["account"],
        "x-module": "M2",
