{
  "openapi": "3.1.0",
  "info": {
    "title": "Aisenhub Account API",
    "version": "1.0.0",
    "description": "Frozen V1 Account contract. Route implementations are delivered by later M2-M4 tasks; contract-only routes must not return fake success."
  },
  "servers": [{ "url": "https://account.example.invalid" }],
  "tags": [
    { "name": "plans" },
    { "name": "account" },
    { "name": "profile" },
    { "name": "preferences" },
    { "name": "subscription" },
    { "name": "files" },
    { "name": "identity" }
  ],
  "paths": {
    "/v1/plans": {
      "get": {
        "operationId": "listPublicPlans",
        "tags": ["plans"],
        "x-module": "M2",
        "x-implementation-status": "local-only",
        "security": [{ "platformKey": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PlatformKey" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Plans" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/account/principal": {
      "get": {
        "operationId": "getPrincipal",
        "tags": ["account"],
        "x-module": "M2",
        "x-implementation-status": "local-only",
        "security": [{ "platformKey": [], "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/PlatformKey" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Principal" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
