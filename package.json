{
  "name": "next-supabase-saas-kit-turbo-lite",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "MakerKit",
    "url": "https://makerkit.dev"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "preinstall": "pnpm run --filter scripts requirements",
    "build": "turbo build --cache-dir=.turbo",
    "dev": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "typecheck": "turbo typecheck --cache-dir=.turbo",
    "test": "pnpm run test:unit",
    "test:unit": "turbo test:unit --cache-dir=.turbo",
    "test:upload": "node tests/spikes/upload/controlled-receiver.mjs",
    "test:db": "pnpm run --filter scripts supabase db --local",
    "test:api": "node tooling/scripts/src/not-enabled.mjs 'API tests' T04-T16",
    "test:e2e": "node tooling/scripts/src/not-enabled.mjs 'browser E2E tests' T16",
    "runtime:probe": "pnpm run --filter scripts runtime:probe",
    "docs:check": "pnpm run --filter scripts docs:check",
    "contracts:check": "node tooling/scripts/src/openapi-check.mjs",
    "db:start": "pnpm run --filter scripts supabase start",
    "db:stop": "pnpm run --filter scripts supabase stop",
    "db:reset": "pnpm run --filter scripts supabase db-reset",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "pnpm run format:check",
    "format:fix": "oxfmt",
    "healthcheck": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "@manypkg/cli": "catalog:",
    "@turbo/gen": "catalog:",
    "cross-env": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postgres": "3.4.3",
    "supabase": "2.111.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.18.0"
}
